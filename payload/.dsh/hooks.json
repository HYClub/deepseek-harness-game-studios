{
  "$comment": [
    "Generated by tools/build-dsh.mjs from the content source's hook settings.",
    "Consumed by @deepseek-ai/dsh-hooks-claude-code (configPath in the dsh profile patch).",
    "Only hooks with a Node port under dsh-src/hooks/ are enabled; the bash originals",
    "cannot run inside the DSH sandbox (Git Bash fails to start, piped stdio is denied).",
    "Commands are project-relative on purpose: the hook process starts in the session",
    "workspace and each hook resolves its own project root, so a copy of this tree does",
    "not fire hooks against the repository it was copied from."
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/session-start.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \".dsh/hooks/detect-gaps.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "pwsh|bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/validate-commit.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \".dsh/hooks/validate-push.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/validate-assets.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \".dsh/hooks/validate-skill-change.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/rules-context.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "$comment": [
          "Advisory reroute. Upstream raises these two as PreToolUse advisories, and DSH never",
          "surfaces a pre-execute systemMessage (the bridge maps only deny/ask there), so the",
          "model never saw them. The same scripts are registered a second time here, where",
          "additionalContext IS delivered — a commit or push that just happened is still the",
          "right moment to hear about a TODO, a hardcoded value or a protected branch.",
          "The PreToolUse registrations stay: that is where they can still BLOCK."
        ],
        "matcher": "pwsh|bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/validate-commit.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \".dsh/hooks/validate-push.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/notify.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/pre-compact.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/post-compact.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/session-stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/log-agent.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \".dsh/hooks/log-agent-stop.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
