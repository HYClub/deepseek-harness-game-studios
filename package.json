{
  "name": "deepseek-harness-game-studios",
  "version": "0.3.3",
  "description": "DeepSeek Harness port of Claude Code Game Studios (CCGS v1.1.2, MIT): 83 skills, 49 agents, 14 rules, 19 hooks, a studio status line, and a self-installing framework payload — install once, then any folder can start a studio with /start.",
  "type": "module",
  "dependencies": {
    "@deepseek-ai/dsh-hooks-claude-code": "0.2.1-rc.2"
  },
  "exports": {
    "./hooks": "./hooks.js",
    "./statusline": "./statusline/index.js",
    "./statusline/client": "./statusline/client.js",
    "./client": "./statusline/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "hooks.js",
    "selfinstall.mjs",
    "payload/",
    "SELF-INSTALL.md",
    "statusline/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "license": "MIT",
  "author": "HYClub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HYClub/deepseek-harness-game-studios.git"
  },
  "bugs": {
    "url": "https://github.com/HYClub/deepseek-harness-game-studios/issues"
  },
  "homepage": "https://github.com/HYClub/deepseek-harness-game-studios#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "game-development",
    "game-studio",
    "agents",
    "skills",
    "hooks",
    "claude-code",
    "port"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
